generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "mysql"
    url       = env("DB_URL")
    directUrl = env("DIRECT_DATABASE_URL")
}

model Birthday {
    id       BigInt  @id @default(autoincrement()) @db.BigInt
    userId   String  @map("user_id") @db.VarChar(32)
    guildId  String  @map("guild_id") @db.VarChar(32)
    birthday String  @db.VarChar(10)
    disabled Boolean @default(false)

    user  User  @relation(fields: [userId], references: [id])
    guild Guild @relation(fields: [guildId], references: [id])

    @@index([userId])
    @@index([guildId])
    @@index([birthday])
    @@map("birthday")
}

model Guild {
    id                  String    @id @map("guild_id") @db.VarChar(32)
    inviter             String?   @db.VarChar(20)
    announcementChannel String?   @map("announcement_channel") @db.VarChar(20)
    announcementMessage String    @default("<:arrwright:931267038746390578> Today is a special Day!{NEW_LINE}<:gift:931267039094534175> Please wish {MENTION} a happy Birthday <3") @map("announcement_message") @db.VarChar(512)
    overviewChannel     String?   @map("overview_channel") @db.VarChar(20)
    overviewMessage     String?   @map("overview_message") @db.VarChar(20)
    birthdayRole        String?   @map("birthday_role") @db.VarChar(20)
    birthdayPingRole    String?   @map("birthday_ping_role") @db.VarChar(20)
    logChannel          String?   @map("log_channel") @db.VarChar(20)
    timezone            Int       @default(0)
    premium             Boolean   @default(false)
    language            String    @default("en-US") @db.VarChar(5)
    updatedAt           DateTime? @updatedAt @map("last_updated") @db.Timestamp(0)
    disabled            Boolean   @default(false)

    birthday Birthday[]

    @@index([id])
    @@map("guild")
}

model User {
    id            String    @id @map("user_id") @db.VarChar(32)
    username      String?   @db.VarChar(32)
    discriminator String?   @db.VarChar(4)
    premium       Boolean   @default(false)
    updatedAt     DateTime  @updatedAt @map("last_updated") @db.Timestamp(0)

    birthday Birthday[]

    @@index([id])
    @@map("user")
}

model Premium {
    id     Int     @id @default(autoincrement())
    userId String  @map("user_id") @db.VarChar(32)
    guildId String? @map("guild_id") @db.VarChar(32)
    tier   Boolean @default(true)

    @@map("premium")
}

model Tiers {
    id        Int      @id @default(autoincrement())
    name      String?  @db.VarChar(512)
    updatedAt DateTime @updatedAt @map("last_updated") @db.Timestamp(0)

    @@map("tiers")
}

model Blocklist {
    id       BigInt   @id @default(autoincrement()) @db.BigInt
    guildId  String   @map("guild_id") @db.VarChar(32)
    userId   String   @map("user_id") @db.VarChar(32)
    addedAt  DateTime @default(now()) @map("added_at") @db.Timestamp(0)
    disabled Boolean  @default(false)

    @@index([guildId])
    @@index([userId])
    @@map("blocklist")
}
